<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Vocabulario</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0d6efd" />
    <link rel="icon" href="~/icons/icon-192.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Vocabulario</a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Palabras" asp-action="Index">Palabras</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Repaso" asp-action="Index">Repaso</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Meta">Mi meta</a></li>
            </ul>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
