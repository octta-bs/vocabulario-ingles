@model MetaDelDia

<div class="card mb-4 barra-meta">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <strong>Meta de hoy</strong>
            <span class="text-muted">@Model.Respondidas de @Model.Meta ejercicios</span>
        </div>
        <div class="progress" role="progressbar" aria-label="Meta de hoy"
             aria-valuenow="@Model.Porcentaje" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar @(Model.Cumplida ? "bg-success" : "")" style="width: @Model.Porcentaje%"></div>
        </div>
        <div class="small mt-2 @(Model.Cumplida ? "text-success" : "text-muted")">
            @if (Model.Cumplida)
            {
                <text>¡Meta cumplida! 🎉 Puedes seguir practicando si quieres.</text>
            }
            else
            {
                <text>Te faltan @Model.Faltan.</text>
            }
            <a class="ms-1" asp-controller="Home" asp-action="Meta">Cambiar meta</a>
        </div>
    </div>
</div>
