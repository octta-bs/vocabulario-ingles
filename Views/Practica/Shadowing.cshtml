@model Palabra?
@{
    ViewData["Title"] = "Shadowing";
    var categorias = (List<Categoria>)ViewBag.Categorias;
    var categoriaId = (int?)ViewBag.CategoriaId;
    var icono = new ViewDataDictionary(ViewData) { ["Tamano"] = 20 };
}

<h1 class="mb-1">Shadowing</h1>
<p class="text-muted">
    Repetir justo al mismo tiempo que el audio, copiando el ritmo y la entonación, es lo que más rápido mejora
    tu pronunciación. Tres pasos por frase; solo el último se califica.
</p>

<form method="get" asp-action="Shadowing" class="mb-3">
    <label for="categoriaId" class="visually-hidden">Categoría</label>
    <select id="categoriaId" name="categoriaId" class="form-select" onchange="this.form.submit()">
        <option value="">Todas las frases</option>
        @foreach (var categoria in categorias)
        {
            <option value="@categoria.Id" selected="@(categoria.Id == categoriaId)">@categoria.Nombre</option>
        }
    </select>
    <noscript><button type="submit" class="btn btn-outline-secondary mt-2">Cambiar</button></noscript>
</form>

@if (Model == null)
{
    <div class="alert alert-secondary">No hay frases en esta categoría.</div>
}
else
{
    <section class="card card-body mb-3" id="shadowing" data-frase="@Model.Ingles">
        <p class="text-muted small mb-1">@Model.Categoria?.Nombre</p>
        <h2 class="frase-hueco mb-1">@Model.Ingles</h2>
        <details class="mb-0">
            <summary class="text-muted small">Ver en español</summary>
            <span class="small">@Model.Espanol</span>
        </details>
    </section>

    <ol class="pasos-shadowing" aria-label="Pasos">
        <li class="paso" id="paso-1" data-paso="1">
            <h3 class="h6 mb-1"><span class="numero">1</span> Escucha</h3>
            <p class="small text-muted mb-2">Escúchala una vez con atención, sin hablar.</p>
            <button type="button" class="btn btn-outline-primary btn-paso" data-velocidad="normal">
                <partial name="_Icono" model='"bocina"' view-data="icono" /> Escuchar
            </button>
        </li>
        <li class="paso" id="paso-2" data-paso="2">
            <h3 class="h6 mb-1"><span class="numero">2</span> Repite junto con el audio</h3>
            <p class="small text-muted mb-2">
                Habla <strong>al mismo tiempo</strong> que la voz, como su sombra. Primero lento y luego normal;
                repítelo las veces que quieras.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-primary btn-paso" data-velocidad="lento">Lento</button>
                <button type="button" class="btn btn-outline-primary btn-paso" data-velocidad="normal">Normal</button>
            </div>
        </li>
        <li class="paso" id="paso-3" data-paso="3">
            <h3 class="h6 mb-1"><span class="numero">3</span> Dila tú solo</h3>
            <p class="small text-muted mb-2">Ahora sin audio: di la frase y mira qué palabras se entendieron.</p>
            <button type="button" class="btn btn-primary" id="btn-decir">
                <partial name="_Icono" model='"microfono"' view-data="icono" /> Decirla
            </button>
            <p id="estado" class="small text-muted mt-2 mb-0" aria-live="polite"></p>
            <div id="sin-soporte" class="alert alert-warning mt-2 mb-0" hidden>
                Tu navegador no tiene reconocimiento de voz: haz los pasos 1 y 2, que son el shadowing en sí.
                Para calificar el paso 3 usa Chrome o Edge (en <strong>localhost</strong> o con <strong>https</strong>).
            </div>
            <div id="resultado" class="mt-3" hidden>
                <p class="mb-1"><strong id="puntaje"></strong></p>
                <p class="frase-hueco mb-2" id="palabras"></p>
                <p class="text-muted small mb-0">Entendí: <em id="entendido"></em></p>
            </div>
        </li>
    </ol>

    <a class="btn btn-outline-primary btn-lg btn-bloque mt-3" asp-action="Shadowing" asp-route-categoriaId="@categoriaId" asp-route-anterior="@Model.Id">
        Otra frase
    </a>
}

@section Scripts {
    <script src="~/js/practica.js" asp-append-version="true"></script>
    <script src="~/js/shadowing.js" asp-append-version="true"></script>
}
