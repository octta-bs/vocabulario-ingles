@model VocabularioIngles.Data.SituacionesGuiadas.Situacion
@using System.Text.Json
@{
    ViewData["Title"] = Model.Titulo;
    var icono = new ViewDataDictionary(ViewData) { ["Tamano"] = 20 };
    var datos = Model.Turnos.Select(t => new
    {
        dice = t.Dice,
        diceEspanol = t.DiceEspanol,
        respuestas = t.Respuestas.Select(r => new { ingles = r.Ingles, espanol = r.Espanol })
    });
}

<p class="small mb-1"><a asp-action="Index">← Situaciones</a></p>
<h1 class="mb-1">@Model.Titulo</h1>
<p class="text-muted">@Model.Descripcion</p>

<noscript><div class="alert alert-warning">Las situaciones guiadas necesitan JavaScript.</div></noscript>

<script type="application/json" id="turnos">@Html.Raw(JsonSerializer.Serialize(datos))</script>

<section id="inicio-situacion" class="card card-body mb-3">
    <p class="mb-3">
        Son @Model.Turnos.Length turnos. En cada uno escucha lo que te dicen y responde en voz alta con una de las
        respuestas de abajo. Si no se entiende bien, inténtalo otra vez.
    </p>
    <button type="button" class="btn btn-primary btn-lg btn-bloque" id="btn-empezar">Empezar</button>
</section>

<ol class="dialogo" id="dialogo" aria-live="polite"></ol>

<section id="turno" class="card card-body mb-3" hidden>
    <p class="text-muted small mb-1" id="numero-turno"></p>
    <h2 class="h6 mb-2">Tu turno · responde con una de estas</h2>
    <ul class="respuestas-modelo" id="respuestas"></ul>

    <div id="sin-soporte" class="alert alert-warning mb-2" hidden>
        Tu navegador no tiene reconocimiento de voz: di la respuesta en voz alta y toca "Ya la dije".
        Para que te califique usa Chrome o Edge (en <strong>localhost</strong> o con <strong>https</strong>).
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-lg" id="btn-responder">
            <partial name="_Icono" model='"microfono"' view-data="icono" /> Responder
        </button>
        <button type="button" class="btn btn-outline-secondary btn-lg" id="btn-repetir">
            <partial name="_Icono" model='"bocina"' view-data="icono" /> Repetir
        </button>
    </div>
    <p id="estado" class="small text-muted mt-2 mb-0" aria-live="polite"></p>

    <div id="resultado" class="mt-3" hidden>
        <p class="mb-1"><strong id="puntaje"></strong></p>
        <p class="frase-hueco mb-2" id="palabras"></p>
        <p class="text-muted small mb-0">Entendí: <em id="entendido"></em></p>
    </div>

    <button type="button" class="btn btn-outline-primary btn-lg btn-bloque mt-3" id="btn-siguiente" hidden>Siguiente</button>
</section>

<section id="final" class="card card-body mb-3" hidden>
    <h2 class="h5 mb-1">¡Terminaste la situación! 🎉</h2>
    <p class="mb-3" id="resumen"></p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary btn-lg" asp-action="Ver" asp-route-id="@Model.Clave">Otra vez</a>
        <a class="btn btn-outline-primary btn-lg" asp-action="Index">Otra situación</a>
    </div>
</section>

@section Scripts {
    <script src="~/js/practica.js" asp-append-version="true"></script>
    <script src="~/js/situaciones.js" asp-append-version="true"></script>
}
