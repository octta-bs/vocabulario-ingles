@model Palabra
@{
    ViewData["Title"] = Model.Ingles;
}

<a asp-action="Index" class="btn btn-link ps-0">← Volver a la lista</a>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h1 class="@(Model.EsFrase ? "frase-hueco" : "palabra-grande") mb-0">@Model.Ingles</h1>
            <button type="button" class="btn btn-outline-secondary btn-audio" data-texto="@Model.Ingles">🔊 Escuchar</button>
        </div>

        <p class="text-muted mb-3">@Model.Espanol · @(Model.Categoria?.Nombre)</p>

        @if (!string.IsNullOrEmpty(Model.Pronunciacion))
        {
            <p class="mb-1"><strong>Pronunciación:</strong> @Model.Pronunciacion</p>
            <p class="mb-3"><strong>Se lee:</strong> @Model.ComoSeLee</p>
        }

        @if (Model.EsVerbo)
        {
            <table class="table table-sm w-auto">
                <tbody>
                    <tr><th class="pe-4">Presente</th><td>I @Model.Ingles</td></tr>
                    <tr><th class="pe-4">Pasado</th><td>I @Model.Pasado</td></tr>
                    <tr><th class="pe-4">Futuro</th><td>I will @Model.Ingles</td></tr>
                    <tr><th class="pe-4">Participio</th><td>I have @Model.Participio</td></tr>
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(Model.Nota))
        {
            <div class="alert alert-info">@Model.Nota</div>
        }

        @if (!string.IsNullOrEmpty(Model.Ejemplo))
        {
        <p class="mt-3 mb-0">
            <em>@Model.Ejemplo</em>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-audio ms-2" data-texto="@Model.Ejemplo">🔊</button>
            <br />
            <span class="text-muted">@Model.EjemploEs</span>
        </p>
        }
    </div>
</div>
