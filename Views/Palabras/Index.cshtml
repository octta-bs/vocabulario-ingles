@model List<Palabra>
@{
    ViewData["Title"] = "Palabras";
    var categorias = (List<Categoria>)ViewBag.Categorias;
    var categoriaActual = (int?)ViewBag.CategoriaId;
}

<h1 class="mb-3">Palabras</h1>
<p class="text-muted mb-3">@Model.Count @(Model.Count == 1 ? "palabra" : "palabras y frases"). Toca una para ver su pronunciación y ejemplo.</p>

<div class="mb-3">
    <a class="btn btn-sm @(categoriaActual == null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">Todas</a>
</div>
@foreach (var grupo in categorias.GroupBy(c => c.Nivel))
{
    <h2 class="seccion-titulo mb-2">@grupo.Key.Texto() · @grupo.Key.Descripcion()</h2>
    <div class="mb-3 d-flex flex-wrap gap-2">
        @foreach (var categoria in grupo)
        {
            <a class="btn btn-sm @(categoriaActual == categoria.Id ? "btn-primary" : "btn-outline-primary")"
               asp-action="Index" asp-route-categoriaId="@categoria.Id">@categoria.Nombre</a>
        }
    </div>
}

<ul class="opciones lista-palabras">
    @foreach (var palabra in Model)
    {
        <li class="opcion">
            <a class="textos" asp-action="Detalle" asp-route-id="@palabra.Id">
                <span class="nombre">@palabra.Ingles</span>
                <span class="detalle">@palabra.Espanol@(string.IsNullOrEmpty(palabra.ComoSeLee) ? "" : $" · se lee: {palabra.ComoSeLee}")</span>
            </a>
            <button type="button" class="boton-icono btn-audio" data-texto="@palabra.Ingles" aria-label="Escuchar @palabra.Ingles">
                <partial name="_Icono" model='"bocina"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 20 }' />
            </button>
        </li>
    }
</ul>
