@model Ejercicio?
@{
    ViewData["Title"] = "Repaso";
    var pendientes = (int)ViewBag.Pendientes;
    var meta = (MetaDelDia)ViewBag.Meta;
    var icono = new ViewDataDictionary(ViewData) { ["Tamano"] = 22 };

    // Mientras hay ejercicio, la pantalla va "enfocada": sin pestañas, solo el repaso.
    if (Model != null)
    {
        ViewData["ModoEnfocado"] = true;
    }

    var hechas = meta.Respondidas;
    var total = hechas + pendientes;
    var avance = total == 0 ? 0 : hechas * 100 / total;
}

@if (Model != null)
{
    <div class="barra-enfoque">
        <a class="boton-icono" asp-controller="Home" asp-action="Index" aria-label="Salir del repaso">
            <partial name="_Icono" model='"cerrar"' view-data="icono" />
        </a>
        <div class="avance" role="progressbar" aria-label="Avance del repaso de hoy"
             aria-valuenow="@hechas" aria-valuemin="0" aria-valuemax="@total">
            <div style="width: @avance%"></div>
        </div>
        <span class="avance-texto">@pendientes @(pendientes == 1 ? "pendiente" : "pendientes")</span>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
    }

    <partial name="_Ejercicio" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Accion"] = "Responder" }' />
}
else
{
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
    }

    <section class="card card-body text-center mb-4">
        <span class="icono-caja" style="margin: 0 auto 12px; width: 56px; height: 56px; background: var(--exito-suave); color: var(--exito)">
            <partial name="_Icono" model='"palomita"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 28 }' />
        </span>
        <h1 class="h4">Ya no tienes palabras pendientes</h1>
        <p class="text-muted mb-0">Llevas @meta.Respondidas @(meta.Respondidas == 1 ? "ejercicio" : "ejercicios") hoy.</p>
    </section>

    <div class="d-flex gap-2" style="flex-direction: column">
        <a class="btn btn-primary btn-lg btn-bloque" asp-action="Nuevas">Aprender palabras nuevas</a>
        <a class="btn btn-outline-primary btn-lg btn-bloque" asp-action="Errores">Practicar mis errores</a>
    </div>
}
