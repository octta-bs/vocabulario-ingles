@model Ejercicio
@{
    ViewData["Title"] = "Repaso";
    var pendientes = (int)ViewBag.Pendientes;
    var meta = (MetaDelDia)ViewBag.Meta;
    var ritmo = (VocabularioIngles.Services.RitmoNuevas)ViewBag.Ritmo;
    var sinEmpezar = (int)ViewBag.SinEmpezar;
    var aAgregar = Math.Min(ritmo.Cantidad, sinEmpezar);
    var categorias = (List<CategoriaSinEmpezar>)ViewBag.Categorias;
    var elegida = (int?)ViewBag.CategoriaElegida;
    if (elegida != null && categorias.All(c => c.Id != elegida))
    {
        elegida = null; // esa categoría ya no tiene palabras nuevas
    }
}

<h1 class="mb-3">Repaso</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<partial name="_BarraMeta" model="meta" />

@if (Model == null)
{
    <div class="alert alert-secondary">Hoy no tienes palabras pendientes. 🎉</div>
}
else
{
    <p class="text-muted">Te faltan @pendientes por repasar.</p>

    <partial name="_Ejercicio" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Accion"] = "Responder" }' />
}

<a class="btn btn-outline-secondary mt-4" asp-action="Errores">🎯 Practicar mis errores</a>

<form asp-action="AgregarNuevas" method="post" class="mt-4 palabras-nuevas">
    @if (sinEmpezar == 0)
    {
        <button type="submit" class="btn btn-outline-primary" disabled>➕ Ya tienes todas las palabras</button>
    }
    else if (aAgregar == 0)
    {
        <button type="submit" class="btn btn-outline-primary" disabled>➕ Sin palabras nuevas por ahora</button>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <label for="categoriaId" class="visually-hidden">Categoría de las palabras nuevas</label>
            <select id="categoriaId" name="categoriaId" class="form-select w-auto">
                <option value="">Cualquiera (en orden)</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id" selected="@(categoria.Id == elegida)">@categoria.Nombre (@categoria.SinEmpezar sin empezar)</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">
                ➕ Agregar @aAgregar @(aAgregar == 1 ? "palabra nueva" : "palabras nuevas")
            </button>
        </div>
    }

    <div class="form-text">
        @if (ritmo.PorcentajeAciertos is { } porcentaje)
        {
            <text>Llevas @porcentaje% de aciertos en tus últimas respuestas.&nbsp;</text>
            @if (ritmo.Cantidad == 0)
            {
                <text>Cuando llegues a 60%, se desbloquean más palabras.</text>
            }
            else
            {
                <text>Mientras más aciertes, más palabras nuevas te tocan (hasta 8).</text>
            }
        }
        else
        {
            <text>Cuando respondas más ejercicios, la cantidad se ajustará a tus aciertos.</text>
        }
    </div>
</form>
