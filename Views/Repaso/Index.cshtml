@model Ejercicio
@{
    ViewData["Title"] = "Repaso";
    var pendientes = (int)ViewBag.Pendientes;
    var meta = (MetaDelDia)ViewBag.Meta;
    var ritmo = (VocabularioIngles.Services.RitmoNuevas)ViewBag.Ritmo;
    var sinEmpezar = (int)ViewBag.SinEmpezar;
    var aAgregar = Math.Min(ritmo.Cantidad, sinEmpezar);
}

<h1 class="mb-3">Repaso</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<partial name="_BarraMeta" model="meta" />

@if (Model == null)
{
    <div class="alert alert-secondary">Hoy no tienes palabras pendientes. 🎉</div>
}
else
{
    <p class="text-muted">Te faltan @pendientes por repasar.</p>

    <div class="card">
        <div class="card-body">
            @if (Model.EsCompletar)
            {
                <p class="mb-1 text-muted">
                    Completa la frase
                    @if (Model.TiempoVerbal != null)
                    {
                        <span class="badge bg-info text-dark ms-1">@Model.TiempoVerbal</span>
                    }
                </p>
                <h2 class="frase-hueco">@Model.FraseConHueco</h2>
                <p class="text-muted mb-0">@Model.FraseEs</p>
            }
            else if (Model.EsDictado)
            {
                <p class="mb-2 text-muted">
                    Dictado: escucha y escribe
                    @(Model.Tipo == TipoEjercicio.DictadoFrase || Model.Palabra.EsFrase ? "la frase completa" : "la palabra")
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-primary btn-lg btn-audio" data-autoplay
                            data-texto="@Model.TextoAudio">🔊 Escuchar</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg btn-audio" data-lento
                            data-texto="@Model.TextoAudio">🐢 Más lento</button>
                </div>
            }
            else
            {
                <p class="mb-1 text-muted">@(Model.Palabra.EsFrase ? "Escribe la frase en inglés" : "¿Cómo se dice en inglés?")</p>
                <h2 class="@(Model.Palabra.EsFrase ? "frase-hueco" : "palabra-grande")">@Model.Palabra.Espanol</h2>
                @if (Model.Palabra.EsVerbo)
                {
                    <p class="text-muted">(verbo)</p>
                }
            }

            <form asp-action="Responder" method="post" class="mt-3">
                <input type="hidden" name="palabraId" value="@Model.Palabra.Id" />
                <input type="hidden" name="tipo" value="@Model.Tipo" />
                <input type="text" name="respuesta" class="form-control form-control-lg mb-3"
                       autocomplete="off" autocapitalize="none" spellcheck="false" autofocus
                       placeholder="@(Model.EsCompletar ? "Escribe lo que va en el hueco" : Model.EsDictado ? "Escribe lo que oyes" : "")" />
                <button type="submit" class="btn btn-primary btn-lg">Comprobar</button>
            </form>
        </div>
    </div>
}

<form asp-action="AgregarNuevas" method="post" class="mt-4 palabras-nuevas">
    @if (sinEmpezar == 0)
    {
        <button type="submit" class="btn btn-outline-primary" disabled>➕ Ya tienes todas las palabras</button>
    }
    else if (aAgregar == 0)
    {
        <button type="submit" class="btn btn-outline-primary" disabled>➕ Sin palabras nuevas por ahora</button>
    }
    else
    {
        <button type="submit" class="btn btn-outline-primary">
            ➕ Agregar @aAgregar @(aAgregar == 1 ? "palabra nueva" : "palabras nuevas")
        </button>
    }

    <div class="form-text">
        @if (ritmo.PorcentajeAciertos is { } porcentaje)
        {
            <text>Llevas @porcentaje% de aciertos en tus últimas respuestas.&nbsp;</text>
            @if (ritmo.Cantidad == 0)
            {
                <text>Cuando llegues a 60%, se desbloquean más palabras.</text>
            }
            else
            {
                <text>Mientras más aciertes, más palabras nuevas te tocan (hasta 8).</text>
            }
        }
        else
        {
            <text>Cuando respondas más ejercicios, la cantidad se ajustará a tus aciertos.</text>
        }
    </div>
</form>
