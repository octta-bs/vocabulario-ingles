@model ProgresoPalabra
@{
    ViewData["Title"] = "Repaso";
    var pendientes = (int)ViewBag.Pendientes;
}

<h1 class="mb-3">Repaso</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (Model == null || Model.Palabra == null)
{
    <div class="alert alert-secondary">Hoy no tienes palabras pendientes. 🎉</div>
}
else
{
    <p class="text-muted">Te faltan @pendientes por repasar.</p>

    <div class="card">
        <div class="card-body">
            <p class="mb-1 text-muted">¿Cómo se dice en inglés?</p>
            <h2 class="palabra-grande">@Model.Palabra.Espanol</h2>
            @if (Model.Palabra.EsVerbo)
            {
                <p class="text-muted">(verbo)</p>
            }

            <form asp-action="Responder" method="post" class="mt-3">
                <input type="hidden" name="palabraId" value="@Model.PalabraId" />
                <input type="text" name="respuesta" class="form-control form-control-lg mb-3"
                       autocomplete="off" autocapitalize="none" spellcheck="false" autofocus />
                <button type="submit" class="btn btn-primary btn-lg">Comprobar</button>
            </form>
        </div>
    </div>
}

<form asp-action="AgregarNuevas" method="post" class="mt-4">
    <button type="submit" class="btn btn-outline-primary">➕ Agregar 5 palabras nuevas</button>
</form>
