@model Ejercicio?
@{
    ViewData["Title"] = "Practicar mis errores";
    var icono = new ViewDataDictionary(ViewData) { ["Tamano"] = 22 };
    if (Model != null)
    {
        ViewData["ModoEnfocado"] = true;
    }
}

@if (Model == null)
{
    <h1 class="mb-1">Practicar mis errores</h1>
    <div class="alert alert-secondary mt-3">Todavía no has fallado ninguna palabra.</div>
    <a class="btn btn-outline-primary btn-lg btn-bloque" asp-controller="Home" asp-action="Practicar">Volver a Practicar</a>
}
else
{
    <div class="barra-enfoque">
        <a class="boton-icono" asp-controller="Home" asp-action="Practicar" aria-label="Salir de la práctica">
            <partial name="_Icono" model='"cerrar"' view-data="icono" />
        </a>
        <span class="avance-texto" style="flex: 1">Mis errores · práctica extra</span>
    </div>
    <partial name="_Ejercicio" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Accion"] = "ResponderError" }' />
}
