@model RepasoResultado
@{
    ViewData["Title"] = Model.Acerto ? "¡Correcto!" : "Respuesta incorrecta";
    ViewData["ModoEnfocado"] = true;
    var escrito = string.IsNullOrWhiteSpace(Model.RespuestaDada) ? "(nada)" : Model.RespuestaDada;
    var ejercicio = Model.Ejercicio;
    var conFrase = ejercicio.EsCompletar || ejercicio.Tipo == TipoEjercicio.DictadoFrase;
    var esPractica = ViewBag.EsPractica == true;
    var siguiente = (string?)ViewBag.SiguienteAccion ?? "Index";
    var icono = new ViewDataDictionary(ViewData) { ["Tamano"] = 22 };
    var iconoChico = new ViewDataDictionary(ViewData) { ["Tamano"] = 18 };
}

<div class="barra-enfoque">
    <a class="boton-icono" asp-controller="Home" asp-action="@(esPractica ? "Practicar" : "Index")" aria-label="Salir">
        <partial name="_Icono" model='"cerrar"' view-data="icono" />
    </a>
    <span class="avance-texto" style="flex: 1">@(esPractica ? "Mis errores · no cuenta para tu repaso" : "Repaso")</span>
</div>

<section class="card card-body" aria-label="La palabra">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <h1 class="@(Model.Palabra.EsFrase ? "frase-hueco" : "palabra-grande") mb-0">@Model.Palabra.Ingles</h1>
        <button type="button" class="boton-icono btn-audio" data-texto="@Model.Palabra.Ingles" aria-label="Escuchar @Model.Palabra.Ingles">
            <partial name="_Icono" model='"bocina"' view-data="icono" />
        </button>
    </div>
    <p class="text-muted mb-1">@Model.Palabra.Espanol</p>
    @if (!string.IsNullOrEmpty(Model.Palabra.Pronunciacion))
    {
        <p class="mb-1 small">@Model.Palabra.Pronunciacion · se lee: <strong>@Model.Palabra.ComoSeLee</strong></p>
    }
    @if (Model.Palabra.EsFrase)
    {
        @if (!string.IsNullOrEmpty(Model.Palabra.Nota))
        {
            <p class="mb-0 mt-2 text-muted small">@Model.Palabra.Nota</p>
        }
    }
    else if (conFrase)
    {
        <hr />
        <div class="d-flex align-items-center gap-2">
            <p class="mb-0"><em>@ejercicio.FraseCompleta</em></p>
            <button type="button" class="boton-icono btn-audio" data-texto="@ejercicio.FraseCompleta" aria-label="Escuchar la frase">
                <partial name="_Icono" model='"bocina"' view-data="iconoChico" />
            </button>
        </div>
        <p class="text-muted mb-0 small">@ejercicio.FraseEs</p>
    }
    else if (!string.IsNullOrEmpty(Model.Palabra.Ejemplo))
    {
        <p class="mb-0 mt-2"><em>@Model.Palabra.Ejemplo</em></p>
    }
</section>

<section class="panel-resultado @(Model.Acerto ? "" : "error")" aria-labelledby="titulo-resultado" role="status">
    <h2 id="titulo-resultado" class="titulo">
        <span class="circulo"><partial name="_Icono" model='Model.Acerto ? "palomita" : "cerrar"' view-data="iconoChico" /></span>
        @(Model.Acerto ? "¡Correcto!" : "Casi")
    </h2>

    @if (!Model.Acerto)
    {
        <p class="mb-1 small">Escribiste <strong>@escrito</strong>. Lo correcto es:</p>
        <p class="correcta mb-2">@ejercicio.Respuesta</p>
        @if (!esPractica)
        {
            <p class="small text-muted">Esta palabra volverá en unos minutos para que la practiques otra vez.</p>
        }
    }

    <a class="btn btn-primary btn-lg btn-bloque" asp-action="@siguiente" asp-route-anterior="@ViewBag.Anterior">Continuar</a>
</section>
