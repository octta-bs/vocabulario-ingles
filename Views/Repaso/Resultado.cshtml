@model RepasoResultado
@{
    ViewData["Title"] = "Resultado";
    var escrito = string.IsNullOrWhiteSpace(Model.RespuestaDada) ? "(nada)" : Model.RespuestaDada;
    var ejercicio = Model.Ejercicio;
    var conFrase = ejercicio.EsCompletar || ejercicio.Tipo == TipoEjercicio.DictadoFrase;
}

@if (Model.Acerto)
{
    <div class="alert alert-success"><strong>¡Correcto!</strong> 🎉</div>
}
else
{
    <div class="alert alert-danger">
        <strong>Casi.</strong> Escribiste: <strong>@escrito</strong>.
        @if (ejercicio.EsCompletar)
        {
            <text>En el hueco iba: <strong>@ejercicio.Respuesta</strong></text>
        }
        else if (ejercicio.Tipo == TipoEjercicio.DictadoFrase)
        {
            <text>La frase era: <strong>@ejercicio.Respuesta</strong></text>
        }
        else
        {
            <text>Lo correcto es:</text>
        }
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h2 class="palabra-grande mb-0">@Model.Palabra.Ingles</h2>
            <button type="button" class="btn btn-outline-secondary btn-audio" data-texto="@Model.Palabra.Ingles">🔊</button>
        </div>
        <p class="text-muted mb-1">@Model.Palabra.Espanol</p>
        <p class="mb-1">@Model.Palabra.Pronunciacion · se lee: <strong>@Model.Palabra.ComoSeLee</strong></p>
        @if (conFrase)
        {
            <hr />
            @if (ejercicio.EsCompletar)
            {
                <p class="mb-1">
                    @if (ejercicio.TiempoVerbal != null)
                    {
                        <span class="badge bg-info text-dark me-1">@ejercicio.TiempoVerbal</span>
                    }
                    <strong>@ejercicio.Respuesta</strong>
                </p>
            }
            <div class="d-flex align-items-center gap-2">
                <p class="mb-0"><em>@ejercicio.FraseCompleta</em></p>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-audio" data-texto="@ejercicio.FraseCompleta">🔊</button>
            </div>
            <p class="text-muted mb-0">@ejercicio.FraseEs</p>
        }
        else
        {
            <p class="mb-0"><em>@Model.Palabra.Ejemplo</em></p>
        }
    </div>
</div>

<a class="btn btn-primary btn-lg" asp-action="Index">Siguiente</a>
