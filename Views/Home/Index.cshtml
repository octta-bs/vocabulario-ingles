@model ResumenViewModel
@{
    ViewData["Title"] = "Inicio";
}

<h1 class="mb-4">Vocabulario de inglés</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.Pendientes</div>
                <div class="text-muted">Pendientes hoy</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.EnRepaso</div>
                <div class="text-muted">En repaso</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.Dominadas</div>
                <div class="text-muted">Dominadas</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6">@Model.TotalPalabras</div>
                <div class="text-muted">Palabras en total</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary btn-lg" asp-controller="Repaso" asp-action="Index">Empezar repaso</a>
    <a class="btn btn-outline-primary btn-lg" asp-controller="Palabras" asp-action="Index">Ver palabras</a>
</div>
