@model InicioViewModel
@{
    ViewData["Title"] = "Inicio";
    // Anillo de la meta: un círculo de radio 40 mide 251.33 de contorno.
    var contorno = 2 * Math.PI * 40;
    var lleno = contorno * Model.Meta.Porcentaje / 100.0;
    var dash = $"{lleno.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {contorno.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
}

<div class="d-flex align-items-center justify-content-between mb-1">
    <p class="inicio-fecha">@Model.Fecha</p>
    <a class="chip" asp-action="Modo" aria-label="Modo @Model.Modo.Texto(). Cambiar modo">
        Modo @Model.Modo.Texto() · Cambiar
    </a>
</div>
<h1 class="mb-4">@Model.Saludo</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
}

<section class="card card-body tarjeta-meta mb-3" aria-labelledby="titulo-meta">
    <svg width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="Meta de hoy: @Model.Meta.Respondidas de @Model.Meta.Meta ejercicios">
        <circle cx="48" cy="48" r="40" fill="none" stroke="#E4E6EB" stroke-width="10"></circle>
        <circle cx="48" cy="48" r="40" fill="none" stroke="@(Model.Meta.Cumplida ? "#15803D" : "#4338CA")" stroke-width="10"
                stroke-linecap="round" stroke-dasharray="@dash" transform="rotate(-90 48 48)"></circle>
        <text x="48" y="47" text-anchor="middle" font-size="22" font-weight="700" fill="#15171C">@Model.Meta.Respondidas</text>
        <text x="48" y="65" text-anchor="middle" font-size="12" fill="#5B6170">de @Model.Meta.Meta</text>
    </svg>
    <div class="detalle">
        <h2 id="titulo-meta" class="h6 mb-0">Meta de hoy</h2>
        <p class="mb-0 text-muted small">
            @if (Model.Meta.Cumplida)
            {
                <text>¡Meta cumplida! Puedes seguir si quieres.</text>
            }
            else
            {
                <text>Te faltan @Model.Meta.Faltan @(Model.Meta.Faltan == 1 ? "ejercicio" : "ejercicios")</text>
            }
        </p>
        @if (Model.Racha > 0)
        {
            <span class="chip chip-racha">
                <partial name="_Icono" model='"fuego"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 14 }' />
                @Model.Racha @(Model.Racha == 1 ? "día seguido" : "días seguidos")
            </span>
        }
        <a class="small" asp-action="Meta">Cambiar meta</a>
    </div>
</section>

@if (Model.Pendientes > 0)
{
    <a class="boton-principal mb-4" asp-controller="Repaso" asp-action="Index">
        <span style="flex: 1">
            <span class="titulo">Empezar repaso</span>
            <span class="subtitulo">
                @Model.Pendientes @(Model.Pendientes == 1 ? "palabra pendiente" : "palabras pendientes")
            </span>
        </span>
        <partial name="_Icono" model='"flecha"' />
    </a>
}
else if (Model.NuevasPorAgregar > 0)
{
    <a class="boton-principal mb-4" asp-controller="Repaso" asp-action="Nuevas">
        <span style="flex: 1">
            <span class="titulo">Aprender palabras nuevas</span>
            <span class="subtitulo">Ya repasaste todo. Te tocan @Model.NuevasPorAgregar nuevas.</span>
        </span>
        <partial name="_Icono" model='"flecha"' />
    </a>
}
else
{
    <div class="card card-body mb-4">
        <h2 class="h6 mb-1">Ya repasaste todo por hoy</h2>
        <p class="mb-0 text-muted small">Puedes practicar en voz alta o con un simulacro de entrevista.</p>
    </div>
}

@if (Model.PendientesOtroModo > 0)
{
    <p class="alert alert-info small">
        También tienes @Model.PendientesOtroModo @(Model.PendientesOtroModo == 1 ? "palabra pendiente" : "palabras pendientes")
        en modo @VocabularioIngles.Services.Modos.Otro(Model.Modo).Texto().
        <a asp-action="Modo">Cambiar de modo</a>
    </p>
}

<h2 class="seccion-titulo">Practica también</h2>
<div class="accesos">
    @if (Model.Modo == VocabularioIngles.Services.ModoApp.Trabajo)
    {
        <a class="acceso" asp-controller="Practica" asp-action="Shadowing">
            <span class="icono-caja"><partial name="_Icono" model='"microfono"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
            <span class="nombre">Shadowing</span>
            <span class="detalle">Repite frases junto con el audio</span>
        </a>
        <a class="acceso" asp-controller="Simulacro" asp-action="Index">
            <span class="icono-caja"><partial name="_Icono" model='"maletin"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
            <span class="nombre">Entrevista</span>
            <span class="detalle">Simulacro de 5 preguntas</span>
        </a>
    }
    else
    {
        <a class="acceso" asp-controller="Palabras" asp-action="Index">
            <span class="icono-caja"><partial name="_Icono" model='"lista"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
            <span class="nombre">Todas las palabras</span>
            <span class="detalle">Escúchalas por categoría</span>
        </a>
        <a class="acceso" asp-controller="Ninos" asp-action="Index">
            <span class="icono-caja"><partial name="_Icono" model='"estrella"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
            <span class="nombre">Niños</span>
            <span class="detalle">Dibujos y audio para preescolar</span>
        </a>
    }
    <a class="acceso" asp-controller="Repaso" asp-action="Errores">
        <span class="icono-caja"><partial name="_Icono" model='"diana"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
        <span class="nombre">Mis errores</span>
        <span class="detalle">@(Model.Errores == 0 ? "Aún no fallas ninguna" : $"{Model.Errores} para reforzar")</span>
    </a>
    <a class="acceso" asp-controller="Repaso" asp-action="Nuevas">
        <span class="icono-caja"><partial name="_Icono" model='"mas"' view-data='new ViewDataDictionary(ViewData) { ["Tamano"] = 22 }' /></span>
        <span class="nombre">Palabras nuevas</span>
        <span class="detalle">@(Model.NuevasPorAgregar == 0 ? "Primero refuerza las tuyas" : $"Te tocan {Model.NuevasPorAgregar}")</span>
    </a>
</div>
