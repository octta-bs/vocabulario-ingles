@model PracticarViewModel
@using VocabularioIngles.Services
@{
    ViewData["Title"] = "Practicar";
    var errores = Model.Errores == 0 ? "Todavía no has fallado ninguna palabra"
        : Model.Errores == 1 ? "1 palabra que fallaste" : $"{Model.Errores} palabras que más fallas";
    var misErrores = new OpcionPracticar("Repaso", "Errores", "diana", "Mis errores", errores);
    var diagnostico = new OpcionPracticar("Diagnostico", "Index", "diana", "Diagnóstico de nivel",
        "Tu nivel por área y qué te falta practicar");
    var todas = new OpcionPracticar("Palabras", "Index", "lista", "Todas las palabras",
        $"{Model.TotalPalabras} palabras y frases en {Model.Categorias} categorías");
}

<h1 class="mb-1">Practicar</h1>
<p class="text-muted mb-4">Modo @Model.Modo.Texto() · práctica extra, además de tu repaso.</p>

@if (Model.Recomendacion is { } r)
{
    <h2 class="seccion-titulo">Hoy te recomiendo</h2>
    <a class="boton-principal mb-4" id="recomendacion" asp-controller="@r.Controlador" asp-action="@r.Accion" asp-route-id="@r.Id">
        <span class="icono-caja icono-recomendado"><partial name="_Icono" model="r.Icono" /></span>
        <span style="flex: 1">
            <span class="titulo">@r.Titulo</span>
            <span class="subtitulo">@r.Motivo</span>
        </span>
        <partial name="_Icono" model='"flecha"' />
    </a>
}

@if (Model.Modo == ModoApp.Trabajo)
{
    <section class="grupo-practicar" aria-labelledby="grupo-hablar">
        <h2 class="seccion-titulo" id="grupo-hablar">Hablar</h2>
        <ul class="opciones">
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Situaciones", "Index", "bandera", "Situaciones guiadas", "Conversaciones de trabajo: stand-up, entrevista, code review")' />
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Simulacro", "Index", "maletin", "Simulacro de entrevista", $"5 preguntas · {Model.RespuestasEscritas} de {Model.TotalPreguntas} respuestas tuyas escritas")' />
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Practica", "Shadowing", "bocina", "Shadowing", "Escucha, repite junto con el audio y dila tú solo")' />
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Practica", "Index", "microfono", "Hablar en voz alta", "Di frases de trabajo y revisa tu pronunciación")' />
        </ul>
    </section>

    <section class="grupo-practicar" aria-labelledby="grupo-leer">
        <h2 class="seccion-titulo" id="grupo-leer">Leer y escribir</h2>
        <ul class="opciones">
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Gramatica", "Index", "lapiz", "Gramática", $"{Model.TotalTemasGramatica} temas con su regla · {Model.TemasGramaticaEmpezados} en tu repaso")' />
            <partial name="_OpcionPracticar" model='new OpcionPracticar("Lecturas", "Index", "lista", "Leer en contexto", "Pega un texto de tu trabajo y guarda las palabras que no conoces")' />
            <partial name="_OpcionPracticar" model='new OpcionPracticar("MisRespuestas", "Index", "lapiz", "Mis respuestas", "Escribe tus respuestas de entrevista")' />
        </ul>
    </section>
}

<section class="grupo-practicar" aria-labelledby="grupo-repasar">
    <h2 class="seccion-titulo" id="grupo-repasar">Repasar</h2>
    <ul class="opciones">
        <partial name="_OpcionPracticar" model="misErrores" />
        <partial name="_OpcionPracticar" model="diagnostico" />
        <partial name="_OpcionPracticar" model="todas" />
    </ul>
</section>

@if (Model.Modo == ModoApp.Principiante)
{
    <p class="text-muted small mt-3">
        Hablar, gramática, situaciones guiadas y el simulacro de entrevista están en el modo Trabajo.
        <a asp-action="Modo">Cambiar de modo</a>
    </p>
}
